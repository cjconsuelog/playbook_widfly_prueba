---
# tasks file for crea_resplado
- name: Crea Respaldos {{ nombre_respaldo }}
  copy:
    src: "{{ ruta_origen }}"
    dest: "{{ ruta_destino }}"
    remote_src: yes
    mode: preserve  
    directory_mode: yes 

- name: Validar que se creo el respaldo {{ nombre_respaldo }}
  command: "{{ comando }}"
  register: command_result

- name: Guarda salida
  debug:
    msg: "{{ command_result.stdout_lines }}"

