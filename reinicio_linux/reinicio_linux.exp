#!/usr/bin/expect -f

exp_internal 1

#Genera un tiempo de espera para realizar el login
set timeout 60

# Se obtienen las variables requeridas de accesos 
set PASSWORD [lindex $argv 0]
set IP       [lindex $argv 1]
set USER     [lindex $argv 2]
spawn ssh -o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1 -o HostKeyAlgorithms=+ssh-rsa,ssh-dss -o PubkeyAcceptedKeyTypes=+ssh-rsa,ssh-dss -o RequiredRSASize=1024 -o StrictHostKeyChecking=no "$USER@$IP"
expect {
  "password:" { send "$PASSWORD\r" }
  timeout { puts "Timeout esperando password"; exit 1 }
}

# Tiempo de espera para que cargue la interfaz de IBM 4690 después de login por SSH
sleep 3

# Se agrega nombre de usuario, al final siempre debe ir \r, esto es igual a un "enter"
send "$USER\r"
sleep 2

#Se especifica el Password del usuario, se debe poner un \r al final, esto es igual a un "enter" 
send "$PASSWORD\r"
sleep 2

# Selección número 7 para tener acceso a la consola
send "7\r"
sleep 2

# A partir de esta línea se definen todos los comandos que se requieren para realizar alguna tarea en especifico.
send "ADXCS20L BACKGRND N 16\r"
sleep 10
